#!/bin/bash
# Homebrew service entrypoint. Runtime artifacts live outside the checkout so
# cargo clean and frontend rebuilds cannot remove files used by the service.

set -euo pipefail

APP_SUPPORT_DIR="${NIXONNOTE_APP_SUPPORT_DIR:-$HOME/Library/Application Support/NixonNote}"
RUNTIME_DIR="${NIXONNOTE_RUNTIME_DIR:-$APP_SUPPORT_DIR/runtime}"
CURRENT_DIR="$RUNTIME_DIR/current"
ENV_FILE="${NIXONNOTE_ENV_FILE:-$HOME/.config/nixonnote/env}"

if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck source=/dev/null
  source "$ENV_FILE"
  set +a
fi

[ -x "$CURRENT_DIR/note" ] || {
  echo "NixonNote runtime is missing. Run 'make deploy' from the project checkout." >&2
  exit 1
}
[ -f "$CURRENT_DIR/web/index.html" ] || {
  echo "NixonNote web runtime is missing. Run 'make deploy' from the project checkout." >&2
  exit 1
}

mkdir -p "$APP_SUPPORT_DIR/data"
export NOTE_PORT="${APP_PORT:-9999}"
export NOTE_DB="${NOTE_DB:-$APP_SUPPORT_DIR/data/note.db}"
export NOTE_WEB_DIR="$CURRENT_DIR/web"

cd "$CURRENT_DIR"
exec "$CURRENT_DIR/note"
